# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public URL of the app (used for metadata / sitemap)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to "false" only when running the production build over plain HTTP locally
# COOKIE_SECURE=false

# AI assistant (server-side only — never exposed to the browser)
# AI_PROVIDER=openai | anthropic   (auto-detected if omitted)
AI_API_KEY=
AI_MODEL=
# Optional: OpenAI-compatible base URL (Groq, Together, Azure, local LLMs ...)
# AI_BASE_URL=https://api.openai.com/v1

# Billing (not wired yet — schema and abstraction are ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
